# Server-only Gemini credential. Configure this in Vercel; never expose it as VITE_GEMINI_API_KEY.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase Admin credentials used by api/gemini.ts to verify Firebase ID tokens.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Keep the \n escape sequences when setting this value in Vercel.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Shared Upstash-compatible Redis REST credentials used for cross-invocation Gemini limits.
# Leave unset for local development only; production must configure both values.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional public application URL used by deployment-specific links.
APP_URL="https://your-project.vercel.app"

# Optional per-mode overrides. Defaults are defined in api/rateLimit.ts.
# Example: ATSA_GEMINI_MEDIA_ANALYSIS_USER_PER_MINUTE=3
# ATSA_GEMINI_MEDIA_ANALYSIS_IP_PER_MINUTE=8
# ATSA_GEMINI_MEDIA_ANALYSIS_DAILY_QUOTA=30
